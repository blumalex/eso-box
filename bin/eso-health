#!/usr/bin/env python3
"""eso-box: a health page for the box at http://<box>:8090, reachable only from your tailnet.

Records a reading every minute (CPU, load, memory, temperatures, fans, time the CPU spent
throttled by heat, memory pressure, disk, battery and AC, Claude Code sessions and their memory)
and keeps 31 days; every 15 minutes it checks for pending updates, a needed restart, failed
services and out-of-memory kills. Runs as the systemd user service eso-health,
which install.sh --health sets up (Linux only: it reads /proc and /sys).

Off-box status (optional): put a healthchecks.io ping URL in ~/.config/eso-box/health-ping-url
and every 15 minutes the box sends it a plain-text status. healthchecks.io then shows the last
status when the box is down, and alerts you when the pings stop.
"""
import glob
import ipaddress
import json
import os
import re
import socket
import sqlite3
import subprocess
import threading
import time
import traceback
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse

HOME = os.path.expanduser("~")
DATA = os.path.join(HOME, ".local/share/eso-box")
DB = os.path.join(DATA, "health.db")
PAGE = os.path.join(DATA, "health.html")
PING_URL_FILE = os.path.join(HOME, ".config/eso-box/health-ping-url")
PORT = 8090
# Loopback and Tailscale's address range. Without the --firewall option the port is open on
# the LAN too, so the page refuses everyone else itself.
ALLOWED = [ipaddress.ip_network(n) for n in ("127.0.0.0/8", "100.64.0.0/10")]
CLAUDE_VERSIONS = os.path.join(HOME, ".local/share/claude/versions/")
APT_CHECK = "/usr/lib/update-notifier/apt-check"  # Debian/Ubuntu; elsewhere no updates tile
# ms the CPU package has spent throttled since boot (Intel; every CPU in the package reports the
# same total); elsewhere no throttling chart
THROTTLE_MS = "/sys/devices/system/cpu/cpu0/thermal_throttle/package_throttle_total_time_ms"
KEEP_S = 31 * 86400
CHECK_EVERY_S = 15 * 60
GIB = 1 << 30
# range -> (span, bucket) in seconds: 60 / 288 / 336 / 360 points
RANGES = {"1h": (3600, 60), "24h": (86400, 300), "7d": (7 * 86400, 1800), "30d": (30 * 86400, 7200)}

READING_COLS = ["cpu", "load1", "mem_used", "mem_total", "swap_used", "cpu_temp", "ssd_temp",
                "disk_used", "disk_total", "battery", "on_ac", "claude_n", "claude_mem",
                "fan1", "fan2", "throttle_pct", "mem_pressure"]


def db():
    con = sqlite3.connect(DB, timeout=10)
    con.row_factory = sqlite3.Row
    return con


def init_db():
    os.makedirs(DATA, exist_ok=True)
    with db() as con:
        con.execute("PRAGMA journal_mode=WAL")
        con.execute(f"CREATE TABLE IF NOT EXISTS readings (ts INTEGER PRIMARY KEY, "
                    f"{', '.join(c + ' REAL' for c in READING_COLS)})")
        have = {r[1] for r in con.execute("PRAGMA table_info(readings)")}
        for c in READING_COLS:
            if c not in have:  # added after the table was made; older rows read NULL
                con.execute(f"ALTER TABLE readings ADD COLUMN {c} REAL")
        con.execute("CREATE TABLE IF NOT EXISTS checks (ts INTEGER PRIMARY KEY, data TEXT)")


def read(path):
    with open(path) as f:
        return f.read().strip()


def safe(fn):
    """One sensor failing (sysfs reads do, now and then) must not lose the whole reading."""
    try:
        return fn()
    except (OSError, ValueError):
        return None


def cpu_counters():
    v = [int(x) for x in read("/proc/stat").split("\n")[0].split()[1:9]]
    idle = v[3] + v[4]  # idle + iowait
    return sum(v) - idle, sum(v)


def zone_temp(kind):
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        if safe(lambda: read(z + "/type")) == kind:
            return int(read(z + "/temp")) / 1000


def hwmon_temp(name):
    for h in glob.glob("/sys/class/hwmon/hwmon*"):
        if safe(lambda: read(h + "/name")) == name:
            return int(read(h + "/temp1_input")) / 1000


def cpu_temp():
    """Intel package, then Intel/AMD hwmon, then a Raspberry Pi's zone."""
    for t in (lambda: zone_temp("x86_pkg_temp"), lambda: hwmon_temp("coretemp"),
              lambda: hwmon_temp("k10temp"), lambda: zone_temp("cpu-thermal")):
        v = safe(t)
        if v is not None:
            return v


def fans():
    """rpm of the first two fans the kernel reports (a laptop's, a Pi's cooler, a board's fan
    headers); None for each one the machine doesn't have. The generic acpi_fan device counts only
    where nothing else reports a fan: beside a platform driver's real reading (a ThinkPad's) it
    sits at 0."""
    paths = sorted(glob.glob("/sys/class/hwmon/hwmon*/fan[0-9]*_input"))
    named = [p for p in paths if safe(lambda p=p: read(os.path.dirname(p) + "/name")) != "acpi_fan"]
    rpm = [safe(lambda p=p: int(read(p))) for p in (named or paths)[:2]]
    return rpm + [None] * (2 - len(rpm))


def stall_us():
    """µs since boot that at least one task waited for memory (PSI "some"; Linux 4.20+)."""
    return int(read("/proc/pressure/memory").split("\n")[0].rsplit("total=", 1)[1])


def share(before, after, span):
    """How much of span a since-boot counter grew by, in %; None when either read failed."""
    if before is None or after is None or span <= 0:
        return None
    return min(100.0, 100 * (after - before) / span)


def power():
    """(battery %, on AC 1/0); None where the machine has no such supply (a desktop has neither)."""
    bat = ac = None
    for d in sorted(glob.glob("/sys/class/power_supply/*")):
        kind = safe(lambda: read(d + "/type"))
        # scope "Device" is a mouse or keyboard battery, not the machine's
        if kind == "Battery" and bat is None and safe(lambda: read(d + "/scope")) != "Device":
            bat = safe(lambda: float(read(d + "/capacity")))
        elif kind == "Mains" and ac is None:
            ac = safe(lambda: int(read(d + "/online")))
    return bat, ac


def meminfo():
    m = {}
    for line in read("/proc/meminfo").split("\n"):
        k, v = line.split(":")
        m[k] = int(v.split()[0]) * 1024
    return m


def claude_procs():
    """Sessions = Claude processes whose parent is a tmux server (eso-session starts them so);
    memory = every Claude process (helpers too) by PSS, since RSS counts the shared binary once
    per process."""
    sessions, pss = 0, 0
    for p in glob.glob("/proc/[0-9]*"):
        try:
            if not os.readlink(p + "/exe").startswith(CLAUDE_VERSIONS):
                continue
            pss += next(int(line.split()[1]) * 1024 for line in read(p + "/smaps_rollup").split("\n")
                        if line.startswith("Pss:"))
            ppid = read(p + "/stat").rsplit(")", 1)[1].split()[1]
            sessions += read(f"/proc/{ppid}/comm").startswith("tmux")
        except (OSError, ValueError, StopIteration):
            pass  # not ours, or exited mid-scan
    return sessions, pss


def reading(cpu_pct, throttle_pct, mem_pressure):
    m = safe(meminfo) or {}
    fs = os.statvfs("/")
    n, pss = claude_procs()
    bat, ac = power()
    fan1, fan2 = fans()
    return {
        "cpu": cpu_pct,
        "load1": safe(lambda: float(read("/proc/loadavg").split()[0])),
        "mem_used": m.get("MemTotal", 0) - m.get("MemAvailable", 0) if m else None,
        "mem_total": m.get("MemTotal"),
        "swap_used": m.get("SwapTotal", 0) - m.get("SwapFree", 0) if m else None,
        "cpu_temp": cpu_temp(),
        "ssd_temp": safe(lambda: hwmon_temp("nvme")),
        "disk_used": (fs.f_blocks - fs.f_bfree) * fs.f_frsize,
        "disk_total": fs.f_blocks * fs.f_frsize,
        "battery": bat,
        "on_ac": ac,
        "claude_n": n,
        "claude_mem": pss,
        "fan1": fan1,
        "fan2": fan2,
        "throttle_pct": throttle_pct,
        "mem_pressure": mem_pressure,
    }


def record_loop():
    busy0, total0 = cpu_counters()
    t0, thr0, stall0 = time.monotonic(), safe(lambda: int(read(THROTTLE_MS))), safe(stall_us)
    last_prune = 0
    while True:
        time.sleep(60 - time.time() % 60)  # on the minute
        busy, total = cpu_counters()
        t, thr, stall = time.monotonic(), safe(lambda: int(read(THROTTLE_MS))), safe(stall_us)
        cpu = 100 * (busy - busy0) / (total - total0) if total > total0 else None
        r = reading(cpu, share(thr0, thr, (t - t0) * 1e3), share(stall0, stall, (t - t0) * 1e6))
        busy0, total0, t0, thr0, stall0 = busy, total, t, thr, stall
        now = int(time.time())
        with db() as con:
            con.execute(f"INSERT OR REPLACE INTO readings (ts, {', '.join(READING_COLS)}) "
                        f"VALUES (?, {', '.join('?' * len(READING_COLS))})",
                        [now] + [r[c] for c in READING_COLS])
            if now - last_prune > 3600:
                con.execute("DELETE FROM readings WHERE ts < ?", (now - KEEP_S,))
                con.execute("DELETE FROM checks WHERE ts < ?", (now - KEEP_S,))
                last_prune = now
        if now // 60 % 15 == 0:
            ping(summary(api_status()))


def failed_units(*scope):
    p = subprocess.run(["systemctl", *scope, "--failed", "--plain", "--no-legend"],
                       capture_output=True, text=True, timeout=30)
    return [line.split()[0] for line in p.stdout.splitlines() if line.strip()]


def oom_kills():
    """(kills since boot, the last one's {at, what} or None). The kernel counts its own OOM kills;
    systemd-oomd, which Ubuntu runs to act first on memory pressure, is only in the journal. Reading
    the system journal needs the adm or systemd-journal group: without it, oomd's kills and the
    last kill's name go missing."""
    kernel = int(next(line.split()[1] for line in read("/proc/vmstat").split("\n")
                      if line.startswith("oom_kill ")))
    p = subprocess.run(["journalctl", "-b", "-q", "--no-pager", "-o", "short-iso", "-g", "Killed",
                        "_TRANSPORT=kernel", "+", "_SYSTEMD_UNIT=systemd-oomd.service"],
                       capture_output=True, text=True, timeout=60)
    lines = p.stdout.splitlines()
    oomd = sum(" systemd-oomd[" in line for line in lines)
    if not lines:
        return kernel + oomd, None
    # kernel: "Out of memory: Killed process 123 (name) ..."; oomd: "Killed /user.slice/.../x.scope due to ..."
    m = re.search(r"Killed process \d+ \(([^)]+)\)|Killed (\S+)", lines[-1])
    what = (m[1] or m[2].rsplit("/", 1)[-1]) if m else lines[-1].split(": ", 1)[-1]
    return kernel + oomd, {"at": lines[-1][:16].replace("T", " "), "what": what}


def run_checks():
    updates = security = None
    if os.path.exists(APT_CHECK):
        # what Ubuntu's login message uses: "<all>;<security>" on stderr
        p = subprocess.run([APT_CHECK], capture_output=True, text=True, timeout=300)
        updates, security = (int(x) for x in (p.stdout + p.stderr).strip().splitlines()[-1].split(";")[:2])
    reboot = os.path.exists("/var/run/reboot-required")
    kills, last_kill = oom_kills()
    return {
        "updates": updates,
        "security": security,
        "reboot_required": reboot,
        "reboot_pkgs": safe(lambda: read("/var/run/reboot-required.pkgs").split()) if reboot else [],
        "failed": failed_units() + [u + " (user)" for u in failed_units("--user")],
        "oom_kills": kills,
        "oom_last": last_kill,
    }


def check_loop():
    while True:
        try:
            data = run_checks()
        except (OSError, ValueError, subprocess.SubprocessError) as e:
            data = {"error": f"{type(e).__name__}: {e}"}
        with db() as con:
            con.execute("INSERT OR REPLACE INTO checks VALUES (?, ?)",
                        (int(time.time()), json.dumps(data)))
        time.sleep(CHECK_EVERY_S)


def summary(st):
    """The plain-text status sent with each ping: what you can still read when the box is down."""
    r, c = st["reading"] or {}, st["checks"] or {}
    n = lambda v, spec=".0f": "?" if v is None else format(v, spec)
    g = lambda b: n(None if b is None else b / GIB, ".1f")
    up = st["now"] - st["boot"]
    lines = [f"{st['host']} at {time.strftime('%Y-%m-%d %H:%M')}, up {int(up // 86400)}d "
             f"{int(up % 86400 // 3600)}h, kernel {st['kernel']}"]
    if "error" in c:
        lines.append("Checks failed: " + c["error"])
    elif c:
        lines.append("Restart: " + (f"NEEDED ({', '.join(c['reboot_pkgs'])})" if c["reboot_required"] else "not needed"))
        if c["updates"] is not None:
            lines.append(f"Updates: {c['updates']} waiting, {c['security']} security")
        lines.append("Failed services: " + (", ".join(c["failed"]) or "none"))
        if "oom_kills" in c:  # absent from checks made before this was added
            last = c["oom_last"]
            lines.append(f"Out-of-memory kills since boot: {c['oom_kills']}"
                         + (f" (last: {last['what']}, {last['at']})" if last else ""))
    if r:
        if r["on_ac"] is not None or r["battery"] is not None:
            lines.append(f"Power: {({1: 'AC', 0: 'ON BATTERY'}).get(r['on_ac'], '?')}, battery {n(r['battery'])}%")
        lines += [
            f"CPU {n(r['cpu'], '.1f')}% (load {n(r['load1'], '.2f')}), CPU {n(r['cpu_temp'])} °C"
            + ("" if r["ssd_temp"] is None else f", SSD {n(r['ssd_temp'])} °C"),
        ]
        fans = [n(r[k]) for k in ("fan1", "fan2") if r.get(k) is not None]
        extra = ([f"fans {' / '.join(fans)} rpm"] if fans else []) + (
            [f"throttled {n(r['throttle_pct'], '.1f')}% of the last minute"]
            if r.get("throttle_pct") is not None else []) + (
            [f"memory pressure {n(r['mem_pressure'], '.1f')}%"] if r.get("mem_pressure") is not None else [])
        if extra:  # only what this machine can report
            text = ", ".join(extra)
            lines.append(text[0].upper() + text[1:])
        lines += [
            f"Memory {g(r['mem_used'])} of {g(r['mem_total'])} GiB (swap {g(r['swap_used'])}), "
            f"disk {g(r['disk_used'])} of {g(r['disk_total'])} GiB",
            f"Claude Code: {n(r['claude_n'])} sessions, {g(r['claude_mem'])} GiB",
        ]
    return "\n".join(lines)


def ping(body):
    url = safe(lambda: read(PING_URL_FILE))
    if not url:
        return
    try:
        urllib.request.urlopen(url, data=body.encode(), timeout=10).close()
    except OSError:
        pass  # offline: the missed ping is itself what raises the alert


def api_status():
    with db() as con:
        last = con.execute("SELECT * FROM readings ORDER BY ts DESC LIMIT 1").fetchone()
        chk = con.execute("SELECT * FROM checks ORDER BY ts DESC LIMIT 1").fetchone()
        first = con.execute("SELECT MIN(ts) FROM readings").fetchone()[0]
    uptime = float(read("/proc/uptime").split()[0])
    return {
        "host": socket.gethostname(),
        "kernel": os.uname().release,
        "cpus": os.cpu_count(),
        "now": time.time(),
        "boot": time.time() - uptime,
        "first_reading": first,
        "reading": dict(last) if last else None,
        "checks": dict(json.loads(chk["data"]), ts=chk["ts"]) if chk else None,
    }


def api_series(rng):
    span, step = RANGES[rng]
    now = int(time.time())
    since = (now - span) // step * step  # bucket-aligned, so the first point sits on the left edge
    with db() as con:
        rows = con.execute(f"""
            SELECT ts / {step} * {step} AS t,
                   AVG(cpu) AS cpu, MAX(cpu) AS cpu_max,
                   AVG(cpu_temp) AS cpu_temp, AVG(ssd_temp) AS ssd_temp,
                   AVG(mem_used) / {GIB}.0 AS mem_used, AVG(claude_mem) / {GIB}.0 AS claude_mem,
                   AVG(swap_used) / {GIB}.0 AS swap_used, MAX(mem_total) / {GIB}.0 AS mem_total,
                   AVG(battery) AS battery, MIN(on_ac) AS on_ac,
                   AVG(claude_n) AS claude_n,
                   AVG(fan1) AS fan1, AVG(fan2) AS fan2,
                   AVG(throttle_pct) AS throttle_pct, AVG(mem_pressure) AS mem_pressure
            FROM readings WHERE ts >= ? GROUP BY t ORDER BY t""", (since,)).fetchall()
    return {"range": rng, "step": step, "since": since, "now": now,
            "rows": [dict(r) for r in rows]}


class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if not any(ipaddress.ip_address(self.client_address[0]) in n for n in ALLOWED):
            return self.send(403, "text/plain", b"only reachable from your tailnet")
        url = urlparse(self.path)
        if url.path == "/":
            return self.send(200, "text/html; charset=utf-8", read(PAGE).encode())
        if url.path == "/api/status":
            return self.send_json(api_status())
        if url.path == "/api/series":
            rng = parse_qs(url.query).get("range", ["24h"])[0]
            if rng in RANGES:
                return self.send_json(api_series(rng))
        self.send(404, "text/plain", b"not found")

    def send_json(self, obj):
        self.send(200, "application/json", json.dumps(obj).encode())

    def send(self, code, ctype, body):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(body)

    def log_message(self, *args):
        pass  # the page polls every minute; keep the journal quiet


def fatal_on_crash(loop):
    """A dead thread would leave the page up but stop recording; exit so systemd restarts us."""
    def run():
        try:
            loop()
        except BaseException:
            traceback.print_exc()
            os._exit(1)
    return run


if __name__ == "__main__":
    init_db()
    threading.Thread(target=fatal_on_crash(record_loop), daemon=True).start()
    threading.Thread(target=fatal_on_crash(check_loop), daemon=True).start()
    ThreadingHTTPServer(("0.0.0.0", PORT), Handler).serve_forever()
